# Copy this file to .env and replace every CHANGE_ME value before starting.
# Generate URL-safe values with: openssl rand -hex 24
MYSQL_DATABASE=wordpress
MYSQL_USER=wpapp
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_MYSQL_EXPORTER_PASSWORD
WORDPRESS_ADMIN_USER=wpadmin
WORDPRESS_ADMIN_PASSWORD=CHANGE_ME_WORDPRESS_ADMIN_PASSWORD
WORDPRESS_ADMIN_EMAIL=admin@example.local
WORDPRESS_SITE_URL=http://localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
